# Sovereign AI Workbench - Git Ignore File

# Exclude Prompts Folder (as specified)
PROMPTS/
prompts/
**/prompts/

# Node.js / Frontend Dependencies & Build
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
**/dist/
build/
.next/
out/

# Python & Caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Databases & Runtime Output Artifacts
*.db
*.sqlite
*.sqlite3
outputs/chromadb/
outputs/data/
outputs/workspace/
outputs/ART-*/
outputs/artifacts/
workspace/sandboxes/*
!workspace/sandboxes/.gitkeep
workspace/uploads/*
!workspace/uploads/.gitkeep
audit_logs/*.jsonl
!audit_logs/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
